APP_NAME="منصة الكاتب الأدبية"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
# ضع رابط موقعك الكامل هنا (بدون شرطة مائلة في النهاية)
APP_URL=https://yourdomain.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# إعدادات قاعدة البيانات على الاستضافة (cPanel / Hostinger)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_cpanel_db_name
DB_USERNAME=your_cpanel_db_user
DB_PASSWORD=your_cpanel_db_password

# إعدادات الجلسات والمصادقة (Sanctum SPA)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# ضع اسم النطاق فقط هنا، مثال: yourdomain.com
SESSION_DOMAIN=yourdomain.com
SESSION_SECURE_COOKIE=true

# ضع نطاق موقعك هنا ليسمح Sanctum بجلسات الواجهة
SANCTUM_STATEFUL_DOMAINS=yourdomain.com,www.yourdomain.com

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# إعدادات البريد الإلكتروني الرسمي (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=465
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# بيانات حساب المدير العام الأولي (يتم إنشاؤه عند تشغيل الـ Seeder)
ADMIN_NAME="المدير العام"
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeThisStrongPassword123!
